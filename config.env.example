# frappe-migrate config — contains secrets, keep chmod 600. Edit per migration.
# ---- source (this server) ----
SRC_BENCH=/home/frappe-user/frappe-bench
SRC_SITE=your-source-site

# ---- target ----
TARGET_HOST=203.0.113.10
TARGET_ROOT_PASS='CHANGE_ME'      # only used once to install the SSH key
TARGET_USER=frappe-user
TARGET_USER_PASS='CHANGE_ME'     # login/sudo password for TARGET_USER on target
TARGET_BENCH=/home/frappe-user/frappe-bench
TARGET_SITE=new.site
TARGET_DB_ROOT_PASS='CHANGE_ME'

# ---- toolchain (match source: bench version, node --version, yarn --version) ----
NODE_MAJOR=18
YARN_VERSION=1.22.22
BENCH_CLI_VERSION=5.22.6

# ---- source credentials (only used to fill the credentials spreadsheet, step 5) ----
SRC_HOST_LABEL='source server'
SRC_USER=frappe-user
SRC_USER_PASS='CHANGE_ME'
SRC_DB_ROOT_USER=root
SRC_DB_ROOT_PASS='CHANGE_ME'
